<Page
    x:Class="PromptDot.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="True"
    KeyDown="OnKeyDown">
  <Grid
      Padding="20"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
      RowSpacing="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Spacing="4">
      <TextBlock
          FontSize="28"
          FontWeight="SemiBold"
          Text="PromptDot" />
      <TextBlock Text="A tiny teleprompter that lives next to your camera." />
    </StackPanel>

    <TextBox
        Grid.Row="1"
        AcceptsReturn="True"
        AutomationProperties.Name="Script editor"
        Header="{Binding ScriptEditorHeader}"
        HorizontalAlignment="Stretch"
        Text="{Binding ScriptText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        TextWrapping="Wrap"
        VerticalAlignment="Stretch" />

    <Grid Grid.Row="2" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button
          AutomationProperties.Name="Load script from file"
          Command="{Binding LoadScriptCommand}"
          Content="Load script" />
      <Button
          Grid.Column="1"
          AutomationProperties.Name="Open Prompter window"
          Command="{Binding ShowPrompterCommand}"
          Content="Prompter" />
      <Button
          Grid.Column="2"
          AutomationProperties.Name="Re-center Prompter window"
          Command="{Binding RecenterCommand}"
          Content="Re-center" />
      <Button
          Grid.Column="4"
          AutomationProperties.Name="Return to beginning"
          Command="{Binding ResetCommand}"
          Content="Home" />
      <Button
          Grid.Column="5"
          AutomationProperties.Name="Previous cue"
          Command="{Binding PreviousCommand}"
          Content="Previous" />
      <Button
          Grid.Column="6"
          AutomationProperties.Name="Play or pause"
          Command="{Binding PlayPauseCommand}"
          Content="{Binding PlayPauseLabel}" />
      <Button
          Grid.Column="7"
          AutomationProperties.Name="Next cue"
          Command="{Binding NextCommand}"
          Content="Next" />
    </Grid>

    <ScrollViewer
        Grid.Row="3"
        HorizontalScrollBarVisibility="Disabled"
        MaxHeight="280">
      <Grid ColumnSpacing="24">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Spacing="8">
          <TextBlock
              FontSize="18"
              FontWeight="SemiBold"
              Text="Playback" />
          <TextBlock Text="{Binding WordsPerMinuteLabel}" />
          <TextBlock
              Text="{Binding ScriptTimingStatus}"
              TextWrapping="Wrap" />
          <TextBlock
              AutomationProperties.Name="Current cue timing"
              Text="{Binding CurrentCueTimingLabel}"
              TextWrapping="Wrap" />
          <Slider
              AutomationProperties.Name="Words per minute"
              IsEnabled="{Binding IsWordsPerMinuteEnabled}"
              Maximum="300"
              Minimum="60"
              StepFrequency="5"
              Value="{Binding WordsPerMinute, Mode=TwoWay}" />
          <ToggleSwitch
              AutomationProperties.Name="Always on top"
              Header="Always on top"
              IsOn="{Binding AlwaysOnTop, Mode=TwoWay}" />
          <Button
              AutomationProperties.Name="Check for application updates"
              Command="{Binding CheckForUpdatesCommand}"
              Content="{Binding UpdateButtonLabel}" />
          <TextBlock
              Text="{Binding UpdateStatus}"
              TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="8">
          <TextBlock
              FontSize="18"
              FontWeight="SemiBold"
              Text="Themes" />
          <ComboBox
              AutomationProperties.Name="Application theme"
              Header="Application"
              ItemsSource="{Binding ApplicationThemes}"
              SelectedItem="{Binding ApplicationTheme, Mode=TwoWay}" />
          <ComboBox
              AutomationProperties.Name="Prompter theme"
              Header="Prompter"
              ItemsSource="{Binding PrompterThemes}"
              SelectedItem="{Binding PrompterTheme, Mode=TwoWay}" />
        </StackPanel>

        <StackPanel Grid.Column="2" Spacing="8">
          <TextBlock
              FontSize="18"
              FontWeight="SemiBold"
              Text="Typography" />
          <TextBox
              AutomationProperties.Name="Font family"
              Header="Font family"
              Text="{Binding FontFamily, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="{Binding FontSizeLabel}" />
          <Slider
              AutomationProperties.Name="Font size"
              Maximum="120"
              Minimum="18"
              StepFrequency="1"
              Value="{Binding FontSize, Mode=TwoWay}" />
          <ComboBox
              AutomationProperties.Name="Font weight"
              Header="Weight"
              ItemsSource="{Binding FontWeights}"
              SelectedItem="{Binding FontWeight, Mode=TwoWay}" />
          <ComboBox
              AutomationProperties.Name="Text alignment"
              Header="Alignment"
              ItemsSource="{Binding TextAlignments}"
              SelectedItem="{Binding TextAlignment, Mode=TwoWay}" />
          <TextBlock Text="Line spacing" />
          <Slider
              AutomationProperties.Name="Line spacing"
              Maximum="2.5"
              Minimum="1"
              StepFrequency="0.1"
              Value="{Binding LineSpacing, Mode=TwoWay}" />
          <TextBlock Text="Background opacity" />
          <Slider
              AutomationProperties.Name="Background opacity"
              Maximum="1"
              Minimum="0"
              StepFrequency="0.05"
              Value="{Binding BackgroundOpacity, Mode=TwoWay}" />
          <TextBlock Text="Previous cue opacity" />
          <Slider
              AutomationProperties.Name="Previous cue opacity"
              Maximum="1"
              Minimum="0"
              StepFrequency="0.05"
              Value="{Binding PreviousCueOpacity, Mode=TwoWay}" />
          <TextBlock Text="Next cue opacity" />
          <Slider
              AutomationProperties.Name="Next cue opacity"
              Maximum="1"
              Minimum="0"
              StepFrequency="0.05"
              Value="{Binding NextCueOpacity, Mode=TwoWay}" />
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <InfoBar
        Grid.RowSpan="4"
        HorizontalAlignment="Stretch"
        IsClosable="True"
        IsOpen="{Binding HasError}"
        Message="{Binding ErrorMessage}"
        Severity="Error"
        VerticalAlignment="Top" />
  </Grid>
</Page>
