<Project Sdk="Uno.Sdk/6.7.30">
  <PropertyGroup>
    <TargetFramework>net10.0-desktop</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>PromptDot.App</RootNamespace>
    <AssemblyName>PromptDot.App</AssemblyName>
    <ApplicationIcon>Assets\Icons\promptdot-icon.ico</ApplicationIcon>
    <!-- Uno's generated desktop application types and Debug assembly metadata trigger these analyzer false positives. -->
    <NoWarn>$(NoWarn);CA1010;CA1016</NoWarn>
    <UnoDisableHotDesign>true</UnoDisableHotDesign>
    <UnoDisableMCPSupport>true</UnoDisableMCPSupport>
    <UnoDisableDevServer>true</UnoDisableDevServer>
    <UnoGenerateCodeBehind>true</UnoGenerateCodeBehind>
    <UnoFeatures>SkiaRenderer;Skia</UnoFeatures>
  </PropertyGroup>
  <ItemGroup>
    <ApplicationDefinition Include="App.xaml" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" />
    <ProjectReference Include="..\PromptDot.Core\PromptDot.Core.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
</Project>
